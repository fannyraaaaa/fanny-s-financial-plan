{
  "entities": {
    "FinancialWorkspace": {
      "title": "Financial Workspace",
      "description": "Unified financial workspace containing wallets, transactions, transfers, recurring rules, wishlist goals, and reconciliation history synced across devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the workspace"
        },
        "name": {
          "type": "string",
          "description": "Name of the workspace"
        },
        "wallets": {
          "type": "array",
          "description": "List of financial wallets and accounts"
        },
        "categories": {
          "type": "array",
          "description": "List of income and expense categories"
        },
        "transactions": {
          "type": "array",
          "description": "List of transactions"
        },
        "transfers": {
          "type": "array",
          "description": "List of wallet transfers"
        },
        "recurring": {
          "type": "array",
          "description": "List of recurring bills"
        },
        "savingsGoals": {
          "type": "array",
          "description": "List of savings goals and wish list items"
        },
        "reconciliationLogs": {
          "type": "array",
          "description": "List of balance reconciliation records"
        },
        "vaultPassword": {
          "type": "string",
          "description": "Vault security password"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of last synchronization"
        },
        "updatedBy": {
          "type": "string",
          "description": "Identifier of the device or user that performed the last update"
        }
      },
      "required": ["id", "wallets", "categories", "transactions", "updatedAt"]
    }
  },
  "firestore": {
    "/financial_workspaces/{workspaceId}": {
      "schema": "FinancialWorkspace",
      "description": "Collection of synchronized financial workspaces"
    }
  }
}

